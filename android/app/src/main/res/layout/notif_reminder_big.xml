<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded habit-reminder notification: dream image on top (as close to full
     width as the decoration allows), then the title and the FULL motivation
     text. Wrapped by DecoratedCustomViewStyle, which supplies the
     app-name/time/icon header.
     The image uses negative side margins to break out of the ~16dp content
     padding so it reaches the notification edges; the text keeps a small inset
     for readability. Image height is kept small so more text lines fit before
     the system's max notification height clips them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/notif_image"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:layout_marginBottom="8dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="0.98"
        android:maxLines="20" />
</LinearLayout>
