<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded habit-reminder notification: dream image on top in a square
     frame, shown WHOLE (fitCenter, no cropping), then the title and the FULL
     motivation text. Wrapped by DecoratedCustomViewStyle, which supplies the
     app-name/time/icon header.
     The square is kept modest (160dp) so text lines still fit before the
     system's max notification height clips them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/notif_image"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="false"
        android:contentDescription="@null" />

    <!-- Text colours: DO NOT use ?android:attr/textColorPrimary here. In a custom
         RemoteViews the theme attr resolves against the APP theme (light → black
         text), not the notification shade (often dark) → unreadable black-on-dark.
         The androidx TextAppearance.Compat.Notification.* styles are built for
         custom notifications and pick a colour that contrasts with the shade. -->
    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textStyle="bold"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
        android:textSize="14sp"
        android:lineSpacingMultiplier="0.98"
        android:maxLines="20" />
</LinearLayout>
